{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-push-check.sh",
            "timeout": 600,
            "onFailure": "block",
            "statusMessage": "pre-push-check: running tests and build before push"
          }
        ]
      }
    ]
  }
}
